# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js v5 (npx auth secret  ili  openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Jedina dva Google računa koja smiju u aplikaciju
ALLOWED_EMAIL_1=
ALLOWED_EMAIL_2=

# Čiji su kalendari (USER_1 = "ja", USER_2 = "supruga")
USER_1_EMAIL=
USER_1_CALENDAR_ID=primary

USER_2_EMAIL=
USER_2_CALENDAR_ID=primary

# Opcionalno: imena prikazana uz događaje (inače se koristi ime iz Google profila)
# USER_1_NAME=
# USER_2_NAME=
